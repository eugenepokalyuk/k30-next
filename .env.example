# Адрес бэкенда. Переменная публичная: запросы уходят из браузера.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Канонический адрес витрины — для метаданных и ссылок в шеринге. Домен
# кириллический (к30маркет.com), в переменных держим punycode: так его видят
# nginx и сертификат, а браузер показывает кириллицу сам.
NEXT_PUBLIC_APP_URL=https://xn--30-8kcuvdm7au.com

# Подкаталог, в котором лежит сайт. Нужен только на GitHub Pages без своего
# домена: там адрес вида eugenepokalyuk.github.io/k30-next. Локально и на
# своём домене оставляем пустым.
NEXT_PUBLIC_BASE_PATH=

# Контакты поддержки в шапке и подвале.
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/K30market
